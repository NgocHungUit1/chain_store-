    "content": "<style type=\"text/css\">body {\n          font-family: Arial, sans-serif;\n          margin: 0;\n          padding: 0;\n          width: 100%;\n        }\n\n        .printBox {\n          font-family: Arial, sans-serif;\n          font-size: 11px;\n          padding: 3px;\n          margin: 5px;\n        }\n\n        table {\n          page-break-inside: auto;\n          border-collapse: collapse;\n          width: 100%;\n        }\n\n        table td {\n            word-wrap: break-word;\n            word-break: break-all;\n        }\n\n        tr {\n          page-break-inside: avoid;\n          page-break-after: auto;\n        }\n\n        img {\n          max-width: 100%;\n          height: auto;\n        }\n\n        th {\n          border-bottom: 1px solid black;\n          border-top: 1px solid black;\n          font-weight: bold;\n          font-size: 11px;\n          text-align: left;\n        }\n        </style>\n        <div class=\"printBox\">\n        <table>\n        <tbody>\n        <tr>\n        <td>{Logo}</td>\n        <td><strong>{Ten_Cua_Hang}</strong><br />\n        Đ/c: {Dia_Chi_Cua_Hang}<br />\n        Điện thoại: {So_Dien_Thoai_Cua_Hang}</td>\n        </tr>\n        </tbody>\n        </table>\n\n        <div style=\"text-align:center; margin: 10px 0; font-size: 14px;\"><strong>{Tieu_De_In}</strong></div>\n\n        <table>\n        <tbody>\n        <tr>\n        <td style=\"vertical-align: top;\">Họ &amp; t&ecirc;n người mua: <strong>{Khach_Hang}</strong></td>\n        <td style=\"vertical-align: top;\">SĐT: <strong>{So_Dien_Thoai}</strong></td>\n        </tr>\n        <tr>\n        <td colspan=\"2\">Đơn vị cơ quan:</td>\n        </tr>\n        <tr>\n        <td colspan=\"2\">Địa chỉ: <strong>{Dia_Chi_Khach_Hang}</strong></td>\n        </tr>\n        </tbody>\n        </table>\n\n        <table border=\"1\">\n        <thead>\n        <tr>\n        <th style=\"width: 10%;\">STT</th>\n        <th style=\"width: 35%;\">T&ecirc;n thuốc/h&agrave;m lượng</th>\n        <th style=\"width: 10%;\">DVT</th>\n        <th style=\"width: 10%; text-align:right\">SL</th>\n        <th style=\"width: 15%; text-align:right\">Đơn gi&aacute;</th>\n        <th style=\"width: 25%; text-align:right\">Th&agrave;nh tiền</th>\n        </tr>\n        </thead>\n        <tbody>\n        <tr>\n        <td>{STT}</td>\n        <td>{Ten_Hang_Hoa}</td>\n        <td>{Don_Vi}</td>\n        <td style=\"text-align:right\">{So_Luong}</td>\n        <td style=\"text-align:right\">{Don_Gia}</td>\n        <td style=\"text-align:right\">{Thanh_Tien}</td>\n        </tr>\n        </tbody>\n        </table>\n\n        <table border=\"1\" style=\"width:100%;\">\n        <tbody>\n        <tr>\n        <td style=\"font-weight: bold; width: 45%;\">Tổng th&agrave;nh tiền:</td>\n        <td style=\"text-align: right; width: 55%;\">{Tong_Cong}</td>\n        </tr>\n        <tr>\n        <td colspan=\"2\">Số tiền bằng chữ: <strong>{Tong_Tien_Hang_Bang_Chu}</strong></td>\n        </tr>\n        </tbody>\n        </table>\n\n        <table style=\"margin-top:10px;text-align:center;width:100%;\">\n        <tbody>\n        <tr>\n        <td>&nbsp;</td>\n        <td style=\"width: 50%;\"><span style=\"font-size:10px;\"><em>Ng&agrave;y {Ngay} th&aacute;ng {Thang} năm {Nam}</em></span></td>\n        </tr>\n        <tr>\n        <td>Người nhận thuốc<br />\n        <em>(K&yacute;, họ t&ecirc;n)</em></td>\n        <td>Người lập ho&aacute; đơn<br />\n        <em>(K&yacute;, họ t&ecirc;n)</em></td>\n        </tr>\n        <tr>\n        <td>&nbsp;</td>\n        <td>\n        <p>&nbsp;</p>\n\n        <p>&nbsp;</p>\n        </td>\n        </tr>\n        </tbody>\n        </table>\n        </div>"
