    "content": "<style type=\"text/css\">body {\n          font-family: Arial, sans-serif;\n          margin: 0;\n          padding: 0;\n          width: 100%;\n        }\n        .printBox {\n          font-family: Arial, sans-serif;\n          font-size: 11px;\n          padding: 3px;\n          margin: 5px;\n        }\n\n        table {\n          page-break-inside: auto;\n          border-collapse: collapse;\n        }\n\n        table td {\n          word-wrap: break-word;\n          word-break: break-all;\n        }\n\n        tr {\n          page-break-inside: avoid;\n          page-break-after: auto\n        }\n\n        img {\n          max-width: 100%;\n          height: auto;\n        }\n</style>\n<div class=\"printBox\">\n<table style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align:center\">\n\t\t\t<table style=\"width:100%\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"font-size: 11px; text-align: left;\">\n\t\t\t\t\t\t<p><strong>PH&Acirc;N PHỐI THUỐC &amp; VTY TẾ</strong></p>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"padding:10px 0 0; text-align:center\"><span style=\"font-size:12px;\"><strong style=\"font-size:12px\">{Tieu_De_In}</strong></span></div>\n\n<table style=\"margin:10px 0 15px; width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"font-size: 11px; width: 60%;\"><span style=\"font-size:11px;\"><strong>Kh&aacute;ch h&agrave;ng:</strong> {Khach_Hang}</span></td>\n\t\t\t<td colspan=\"1\" style=\"font-size: 11px;\"><strong><span style=\"font-size:11px;\">Số HĐ: </span></strong></td>\n\t\t\t<td style=\"font-size: 11px;\"><span style=\"font-size:11px;\">{So_Hoa_Don}</span></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td rowspan=\"2\" style=\"font-size: 11px;\"><span style=\"font-size:11px;\"><strong>SĐT:</strong> {So_Dien_Thoai}</span></td>\n\t\t\t<td colspan=\"1\" rowspan=\"2\" style=\"font-size: 11px;\"><strong><span style=\"font-size:11px;\">Ng&agrave;y giờ b&aacute;n:</span></strong></td>\n\t\t\t<td style=\"font-size: 11px;\"><span style=\"font-size:11px;\">{Ngay_Ban}</span></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-size: 11px;\"><span style=\"font-size:11px;\">{Gio_Ban}</span></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-size: 11px;\"><span style=\"font-size:11px;\"><strong>Địa chỉ:</strong> {Dia_Chi_Khach_Hang}</span></td>\n\t\t\t<td colspan=\"1\" style=\"font-size: 11px; vertical-align: top;\"><strong><span style=\"font-size:11px;\">Nh&acirc;n vi&ecirc;n:</span></strong></td>\n\t\t\t<td style=\"font-size: 11px; vertical-align: top;\"><span style=\"font-size:11px;\">{Nhan_Vien}</span></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<table border=\"1\" style=\"width:100%;\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th scope=\"col\" style=\"border-bottom: 1px solid black; border-top: 1px solid black; width: 10%;\"><span style=\"font-size:11px;\">STT</span></th>\n\t\t\t<th scope=\"col\" style=\"border-bottom: 1px solid black; border-top: 1px solid black; width: 35%;\"><span style=\"font-size:11px;\"><b>T&ecirc;n h&agrave;ng</b></span></th>\n\t\t\t<th scope=\"col\" style=\"border-bottom: 1px solid black; border-top: 1px solid black; width: 15%;\"><span style=\"font-size:11px;\">Đơn vị</span></th>\n\t\t\t<th scope=\"col\" style=\"border-bottom: 1px solid black; border-top: 1px solid black; text-align: right; width: 7%;\"><span style=\"font-size:11px;\"><strong>SL</strong></span></th>\n\t\t\t<th scope=\"col\" style=\"border-bottom: 1px solid black; border-top: 1px solid black; text-align: right; width: 15%;\"><span style=\"font-size:11px;\">Đơn Gi&aacute;</span></th>\n\t\t\t<th scope=\"col\" style=\"border-bottom: 1px solid black; border-top: 1px solid black; text-align: right;\"><span style=\"font-size:11px;\"><strong>Th&agrave;nh tiền</strong></span></th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom: 1px solid black; text-align: center;\"><span style=\"font-size:11px;\">