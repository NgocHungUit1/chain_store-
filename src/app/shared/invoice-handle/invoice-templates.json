    "content": "<style type=\"text/css\">body {\n  font-family: Arial, sans-serif;\n  margin: 0;\n  padding: 0;\n  width: 100%;\n}\n.printBox {\n  font-family: Arial, sans-serif;\n  font-size: 14px;\n  padding: 40px;\n  margin: 16px;\n}\n\ntable {\n  page-break-inside: auto;\n  border-collapse: collapse;\n}\n\ntable td {\n  word-wrap: break-word;\n  word-break: break-all;\n}\n\ntr {\n  page-break-inside: avoid;\n  page-break-after: auto\n}\n\nimg {\n  max-width: 100%;\n  height: auto;\n}\n</style>\n<div class=\"printBox\">\n<table style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align:center\">\n\t\t\t<table style=\"width:100%\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"text-align:center\">{Logo}</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"text-align: center;\"><font face=\"Arial, Helvetica, sans-serif\"><span style=\"font-size: 16px;\"><b>{Ten_Cua_Hang}</b></span></font></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"text-align:center\">{Dia_Chi_Cua_Hang}</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"padding:10px 0 0; text-align:center\"><span style=\"font-size:18px;\"><strong>{Tieu_De_In}</strong></span></div>\n\n<table style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"; text-align:center\"><strong>Số HĐ: {Ma_Don_Hang}</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"; text-align:center\">Ng&agrave;y {Ngay} th&aacute;ng {Thang} năm {Nam}</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<table style=\"width:100%;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>{Thong_Tin_Khach_Hang}</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<table cellpadding=\"3\" style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px solid black; border-top:1px solid black; width:35%\"><strong><span>Đơn gi&aacute;</span></strong></td>\n\t\t\t<td style=\"border-bottom: 1px solid black; border-top: 1px solid black; text-align: right; width: 20%;\"><strong><span>SL</span></strong></td>\n\t\t\t<td style=\"border-bottom: 1px solid black; border-top: 1px solid black; text-align: right; width: 20%;\"><strong><span>Số l&ocirc;</span></strong></td>\n\t\t\t<td style=\"border-bottom:1px solid black; border-top:1px solid black; text-align:right\"><strong>VAT</strong></td>\n\t\t\t<td style=\"border-bottom:1px solid black; border-top:1px solid black; text-align:right\"><strong><span>Th&agrave;nh tiền</span></strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td colspan=\"3\" style=\"padding-top:3px\">{Ten_Hang_Hoa} - ({Don_Vi})</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px dashed black\"><span>{Don_Gia_Chiet_Khau}</span></td>\n\t\t\t<td style=\"border-bottom:1px dashed black; text-align:right\"><span>{So_Luong}</span></td>\n\t\t\t<td style=\"border-bottom:1px dashed black; text-align:right\"><span>{So_Lo}</span></td>\n\t\t\t<td style=\"border-bottom:1px dashed black; text-align:right\">{VAT}</td>\n\t\t\t<td style=\"border-bottom:1px dashed black; text-align:right\"><span>{Thanh_Tien}</span></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<table border=\"0\" cellpadding=\"3\" cellspacing=\"0\" style=\"border-collapse:collapse; margin-top:20px; width:100%\">\n\t<tfoot>\n\t\t<tr>\n\t\t\t<td style=\"font-size: 11px; font-weight: bold; text-align: right; white-space: nowrap; width: 60%;\"><span style=\"font-size:14px;\">Tổng tiền h&agrave;ng (chưa VAT)</span></td>\n\t\t\t<td style=\"font-size:11px; font-weight:bold; text-align:right\"><span style=\"font-size:14px;\">{Tong_Tien_Hang_Chua_VAT}</span></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-size: 11px; font-weight: bold; text-align: right; white-space: nowrap; width: 60%;\"><span style=\"font-size:14px;\">VAT</span></td>\n\t\t\t<td style=\"font-size:11px; font-weight:bold; text-align:right\"><span style=\"font-size:14px;\">{VAT_Tong}</span></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-weight: bold; text-align: right; white-space: nowrap; width: 60%;\">Tổng tiền h&agrave;ng:</td>\n\t\t\t<td style=\"; font-weight:bold; text-align:right\">{Tong_Tien_Hang}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"; font-weight:bold; text-align:right; white-space:nowrap\">Chiết khấu:</td>\n\t\t\t<td style=\"; font-weight:bold; text-align:right\">{Chiet_Khau}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"; font-weight:bold; text-align:right; white-space:nowrap\">Tổng thanh to&aacute;n:</td>\n\t\t\t<td style=\"; font-weight:bold; text-align:right\">{Tong_Cong}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td colspan=\"2\" style=\"font-style:italic; text-align:left\">{Tong_Tien_Hang_Bang_Chu}</td>\n\t\t</tr>\n\t</tfoot>\n</table>\n\n<table style=\"width:100%;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"font-size:9px; font-style:italic; text-align:center\">{Ma_QR}&nbsp;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-size:9px; font-style:italic; text-align:center\"><strong><span style=\"font-size:12px;\">Cảm ơn v&agrave; hẹn gặp lại!</span></strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-size:9px; font-style:italic; text-align:center\">POWERED BY rx20.vn</td>\n\t\t</tr>\n\t</tbody>\n</table>\n</div>"
