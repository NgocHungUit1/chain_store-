    "content": "<style type=\"text/css\">body {\n          font-family: Arial, sans-serif;\n          margin: 0;\n          padding: 0;\n          width: 100%;\n        }\n        .printBox {\n          font-family: Arial, sans-serif;\n          font-size: 14px;\n          padding: 40px;\n          margin: 16px;\n        }\n\n        table {\n          page-break-inside: auto;\n          border-collapse: collapse;\n        }\n\n        table td {\n          word-wrap: break-word;\n          word-break: break-all;\n        }\n\n        tr {\n          page-break-inside: avoid;\n          page-break-after: auto\n        }\n\n        img {\n          max-width: 100%;\n          height: auto;\n        }\n</style>\n<div class=\"printBox\">\n<table style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align:center\">\n\t\t\t<table style=\"width:100%\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"font-size: 11px; text-align: left;\">\n\t\t\t\t\t\t<p><strong>PH&Acirc;N PHỐI THUỐC &amp; VTY TẾ</strong></p>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div style=\"padding:10px 0 0; text-align:center\"><strong style=\"font-size:20px\">{Tieu_De_In}</strong></div>\n\n<table style=\"margin:10px 0 15px; width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width: 60%;\"><strong>Kh&aacute;ch h&agrave;ng:</strong> {Khach_Hang}</td>\n\t\t\t<td colspan=\"1\"><strong>Số HĐ: </strong></td>\n\t\t\t<td>{So_Hoa_Don}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td rowspan=\"2\"><strong>SĐT:</strong> {So_Dien_Thoai}</td>\n\t\t\t<td colspan=\"1\" rowspan=\"2\"><strong>Ng&agrave;y giờ b&aacute;n:</strong></td>\n\t\t\t<td>{Ngay_Ban}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>{Gio_Ban}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>Địa chỉ:</strong> {Dia_Chi_Khach_Hang}</td>\n\t\t\t<td colspan=\"1\" style=\"vertical-align: top;\"><strong>Nh&acirc;n vi&ecirc;n:</strong></td>\n\t\t\t<td style=\"vertical-align: top;\"