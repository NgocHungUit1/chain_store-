style=\"text-align: right;\">{Chiet_Khau}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: right;\"><strong>Tổng cộng:</strong></td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td style=\"text-align: right;\"><strong>{Tong_Cong}</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: right;\"><strong>Kh&aacute;ch thanh to&aacute;n:</strong></td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td style=\"text-align: right;\">{Khach_Thanh_Toan}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: right;\"><strong>C&ograve;n lại:</strong></td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td style=\"text-align: right;\">{Con_Lai}</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<table cellpadding=\"1\" cellspacing=\"1\" style=\"width:100%;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td><em><strong>Bằng chữ: {Tong_Tien_Hang_Bang_Chu}&nbsp;</strong></em></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p style=\"text-align: center;\">{Ma_QR}&nbsp;</p>\n\n<table style=\"margin-top:20px; width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"font-style:italic; text-align:center\">\n\t\t\t<p><strong><em><u>Lưu &yacute;:&nbsp; Giải quyết đổi trả trong v&ograve;ng 3 ng&agrave;y</u></em></strong></p>\n\n\t\t\t<p>Cảm ơn Q&uacute;y kh&aacute;ch!</p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"font-style:italic; text-align:center\">&nbsp;</td>\n\t\t</tr>\n\t</tbody>\n</table>\n</div>\n"
